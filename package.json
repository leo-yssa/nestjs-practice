{
  "name": "nestjs-practice",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:dev": "cross-env NODE_ENV=development nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:migrate:create": "typeorm-ts-node-esm migration:create",
    "db:migrate:generate": "npm run build && cross-env NODE_ENV=production typeorm-ts-node-esm migration:generate -d ./src/config/database/database.options.ts",
    "db:migrate:run": "npm run build && cross-env NODE_ENV=production typeorm-ts-node-esm migration:run -d ./src/config/database/database.options.ts",
    "db:migrate:show": "npm run build && cross-env NODE_ENV=production typeorm-ts-node-esm migration:show -d ./src/config/database/database.options.ts",
    "db:migrate:revert": "npm run build && cross-env NODE_ENV=production typeorm-ts-node-esm migration:revert -d ./src/config/database/database.options.ts",
    "dev:db:migrate:generate": "npm run build:dev && cross-env NODE_ENV=development typeorm-ts-node-esm migration:generate -d ./src/config/database/database.options.ts",
    "dev:db:migrate:show": "npm run build:dev && cross-env NODE_ENV=development typeorm-ts-node-esm migration:show -d ./src/config/database/database.options.ts",
    "dev:db:migrate:run": "npm run build:dev && cross-env NODE_ENV=development typeorm-ts-node-esm migration:run -d ./src/config/database/database.options.ts",
    "dev:db:migrate:revert": "npm run build:dev && cross-env NODE_ENV=development typeorm-ts-node-esm migration:revert -d ./src/config/database/database.options.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/client-ses": "^3.796.0",
    "@aws-sdk/client-sns": "^3.782.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/cron": "^2.0.1",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.3.0",
    "ioredis": "^5.6.0",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.14.0",
    "nest-winston": "^1.10.2",
    "node-forge": "^1.3.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "seatsio": "^85.3.0",
    "typeorm": "^0.3.22",
    "typeorm-naming-strategies": "^4.1.0",
    "ua-parser-js": "^2.0.3",
    "ulid": "^3.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/node-forge": "^1.3.11",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
